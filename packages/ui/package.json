{
  "name": "@gather/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Renderer bundle: rules engine, host bridge, and a control for every §4.2 field type including the matrix. Vite single-file output.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-bundle.mjs",
    "verify": "node scripts/verify-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gather/schema": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
