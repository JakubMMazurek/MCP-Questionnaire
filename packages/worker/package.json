{
  "name": "@gather/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP handler (createMcpHandler + MCP SDK v2) + the per-form Durable Object + ui://forms/renderer (build step 4). See DESIGN.html §3, §6, §7.",
  "scripts": {
    "dev": "node scripts/ensure-bundle.mjs && wrangler dev",
    "check": "node scripts/ensure-bundle.mjs && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node scripts/ensure-bundle.mjs && vitest run",
    "test:watch": "node scripts/ensure-bundle.mjs && vitest",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "dependencies": {
    "@gather/schema": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@gather/ui": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
