{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workers runtime globals (Request, Response, crypto, console, the Durable
    // Object types) come from the generated `worker-configuration.d.ts`, which
    // `wrangler types` writes from the installed workerd. It is generated, not
    // committed — `pnpm typecheck` regenerates it first (no network, no auth).
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}
