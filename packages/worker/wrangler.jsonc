{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-questionnaire",
  "main": "src/index.ts",

  // Pinned, not inferred. Wrangler caches a chosen account in
  // node_modules/.cache/wrangler/wrangler-account.json, and that cache
  // outlived a move between accounts: every API call 401d against the
  // old personal account while the token was for this one. Naming the
  // account here makes the cache irrelevant.
  "account_id": "c097d9123b26798f35337a997ce9ce73",

  // ≥ 2026-02-24 is load-bearing, not cosmetic (DESIGN.html §3): from that date
  // `ctx.storage.deleteAll()` also deletes the active alarm, so the form's TTL
  // handler is a single call instead of deleteAll() + deleteAlarm().
  // Verified: developers.cloudflare.com/durable-objects/api/storage-api/ —
  // "For Workers with a compatibility date of 2026-02-24 or later, deleteAll()
  // also deletes any active alarm."
  "compatibility_date": "2026-08-01",

  // Required, not optional: `agents/mcp/server` imports `node:async_hooks` to
  // carry the per-request auth context, and without the flag the Worker throws
  // at runtime. Verified from the dry-run build's own diagnostic.
  "compatibility_flags": ["nodejs_compat"],

  // The `ui://forms/renderer` body (§7.1). `run_worker_first` keeps the bundle
  // OFF the public routes: the Worker answers every request, serves MCP behind
  // the OAuth bearer token and 404s everything else, and reads the bundle
  // through the binding when an authenticated resources/read arrives. Without
  // it the built HTML would also be a public page at `/`.
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // One Durable Object per form, addressed by the unguessable formId (§3).
  "durable_objects": {
    "bindings": [{ "name": "FORM_DO", "class_name": "FormDO" }]
  },

  // Declarative class lifecycle. The Wrangler configuration reference now says
  // of the imperative `migrations` array — the `new_sqlite_classes` form — that
  // it is "the legacy imperative configuration for managing Durable Object
  // class lifecycle" and that new Workers should "prefer the declarative
  // exports field"; the two are mutually exclusive. `storage: "sqlite"` is the
  // SQLite backend §3 requires (answers as rows, not one blob).
  "exports": {
    "FormDO": { "type": "durable-object", "storage": "sqlite" }
  },

  // On, but nothing in this Worker ever logs an answer, a note or a schema
  // (§3 — "No logging of payloads"). See src/log.ts: the only permitted fields
  // are ids, counts, byte sizes and error codes.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // OAuth grants, tokens and dynamically registered clients (build step 7).
  // The binding name is fixed by `@cloudflare/workers-oauth-provider`, which
  // reads `env.OAUTH_KV` directly.
  //
  // This is NOT a walk-back of §3's "DO, not KV": that decision was about FORM
  // DATA, where eventual consistency could prefill a chained form from a stale
  // draft. Answers still live only in the per-form Durable Object. What is in
  // here is short-lived OAuth bookkeeping that nothing reads twice in a second,
  // which is the shape KV is actually good at — and the library gives no
  // choice regardless.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Title `OAUTH_KV`, on the 365 Finance account.
      "id": "35736a7041914e9188cb978cd9002adb"
    }
  ],

  // §3/§10 — access control, and the upstream identity provider.
  //
  // The gate is a Cloudflare Access policy ("Tech Team"), NOT a list in here.
  // `GITHUB_ALLOWED_USERS` lived at this spot until 2026-10-26: twenty GitHub
  // logins that someone had to remember to edit. Access refuses an unlisted
  // user at its own login page and never redirects back, so membership is
  // managed in Zero Trust and a leaver loses access when their Entra account
  // is disabled — the policy requires Entra as the login method.
  //
  // In `vars` and NOT secrets, deliberately, on the same reasoning the old
  // allowlist used: neither value is a credential. The client id is published
  // in the discovery URL, and the issuer IS a public URL. Only the client
  // secret authenticates anything, and it is set out of band:
  //     wrangler secret put ACCESS_CLIENT_SECRET
  // (an obvious fake lives in `.dev.vars` for local runs and tests).
  //
  // This also sidesteps the step-4 trap — a `vars` entry REPLACES a same-named
  // secret on deploy — by keeping the names disjoint: nothing in `vars` here
  // shares a name with a secret.
  "vars": {
    "ACCESS_CLIENT_ID": "3030004f67ef659a855c849396749d7810760e0fa50acca033d4562bc752c4f2",
    "ACCESS_ISSUER": "https://365-finance.cloudflareaccess.com/cdn-cgi/access/sso/oidc/3030004f67ef659a855c849396749d7810760e0fa50acca033d4562bc752c4f2"
  }
}
