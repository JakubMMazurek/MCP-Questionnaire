# Local-only Cloudflare Access client secret. AN OBVIOUS FAKE — the real value
# is a production secret (`wrangler secret put ACCESS_CLIENT_SECRET`) and never
# appears in this repo.
#
# The client id and issuer are NOT here: they are `vars` in wrangler.jsonc,
# because neither is a credential. Nothing local ever reaches
# cloudflareaccess.com with this: `wrangler dev` can complete the flow only
# against the real SaaS application, and the tests stub the upstream calls and
# mint their own signed ID tokens. It exists so the Worker has something to
# send and the generated types know the binding is a string.
ACCESS_CLIENT_SECRET=not-a-real-secret-local-only

# Local-only HMAC key for /f/:token form URLs. AN OBVIOUS FAKE — production uses
# `wrangler secret put FORM_URL_SECRET`, piped WITHOUT a trailing newline.
FORM_URL_SECRET=dev-only-not-a-real-signing-key
